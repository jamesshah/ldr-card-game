// "//" starts a comment in xcconfig files, so the URL is split with $() to keep it intact.
CONVEX_URL = https:/$()/loyal-lapwing-231.convex.cloud

// Set these in Local.xcconfig to enable Sign in with Apple and APNs on a real device:
//   DEVELOPMENT_TEAM = ABCDE12345
//   CODE_SIGN_ENTITLEMENTS = Support/LDRCards.entitlements
// Point at a local `npx convex dev` backend with:
//   CONVEX_URL = http:/$()/127.0.0.1:3210
#include? "Local.xcconfig"
